struct Person {
    name: string;
    age: int;

    fn describe(): string {
        return "Person";
    }
}

fn add(a: int, b: int): int {
    return a + b;
}

fn main(): int {
    let x: int = 10;
    let y: int = 20;

    let p: Person = Person("Alice", 30);
    let d: string = p.describe();

    return add(x, y);
}

fn mains(person: Person): string {
    return person.describe();
}